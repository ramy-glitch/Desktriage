# Copy to .env. .env is ignored by git.
# Inside Compose, the database host is the service name db
# and the webhook host is the service name webhook.

POSTGRES_USER=desktriage
POSTGRES_PASSWORD=desktriage
POSTGRES_DB=desktriage
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://desktriage:desktriage@db:5432/desktriage

API_PORT=8000
WEBHOOK_PORT=8001
WEBHOOK_URL=http://webhook:8001/notifications

# New Comet project for this repository. Create the project in Comet,
# then paste that project's API key here. Do not reuse another project's key.
COMET_API_KEY=
COMET_PROJECT_NAME=desktriage-classifier
